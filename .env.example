# allinone — example environment template.
# Copy to .env and fill in. NEVER commit the filled .env.

# --- Datastores ---

# PostgreSQL (used by @allinone/database-postgres)
#   Postgres 17 example: postgres://postgres:<password>@localhost:5432/allinone
DATABASE_URL=postgres://postgres:change-me@localhost:5432/allinone

# MongoDB (used by @allinone/database-mongodb)
#   Note: multi-document transactions need a replica set; the adapter
#   declares transactions:false on standalone (fails loudly, never fakes).
MONGO_URL=mongodb://localhost:27017
MONGO_DB=allinone

# SQLite (used by @allinone/database-sqlite; :memory: for tests)
# SQLITE_PATH=./data/app.db

# Redis KV/cache (used by @allinone/database-redis)
REDIS_URL=redis://localhost:6379

# --- Integration test targets (never production) ---

# Live Postgres tests (postgres-live.test.ts) — optional; unit tests run
# against pg-mem when this is unset. Local Docker container:
#   docker run -d --name allinone-pg-test -e POSTGRES_PASSWORD=testpass \
#     -e POSTGRES_DB=allinone_test -p 5433:5432 --rm postgres:17
POSTGRES_TEST_URL=postgres://postgres:testpass@localhost:5433/allinone_test
MONGO_TEST_URL=mongodb://127.0.0.1:27017

# --- SSO / OIDC providers (example: Google) ---

# Secrets belong in your vault/manager, not in git. Wire these
# into createPlatform({ auth: { providers: [...] } }).
SSO_GOOGLE_CLIENT_ID=
SSO_GOOGLE_CLIENT_SECRET=
SSO_GOOGLE_REDIRECT_URI=https://app.example.com/auth/callback
