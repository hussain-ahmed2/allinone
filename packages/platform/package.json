{
  "name": "allinone",
  "version": "0.1.0",
  "description": "Universal application platform — secure by default, database-agnostic, framework-native",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@allinone/config": "workspace:*",
    "@allinone/presets": "workspace:*",
    "@allinone/database": "workspace:*",
    "@allinone/tenancy": "workspace:*",
    "@allinone/auth": "workspace:*",
    "@allinone/cms": "workspace:*",
    "@allinone/infra": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^3.0.0"
  }
}
