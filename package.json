{
  "name": "allinone-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "allinone — universal application platform for custom TypeScript frameworks",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 build",
    "dev": "pnpm -r --parallel dev",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "checks": "pnpm build && pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "docs:dev": "pnpm --filter @allinone/docs dev",
    "docs:build": "pnpm --filter @allinone/docs build",
    "example": "pnpm --filter @allinone/example start",
    "example:express": "pnpm --filter @allinone/example-express start",
    "bench": "pnpm build && node benchmarks/bench.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "eslint": "^10.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "nodemailer": "^10.4.0",
    "react-router": "^8.5.1"
  }
}
